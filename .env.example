APP_NAME=OpsPilot AI
APP_VERSION=1.0.0
DEBUG=false
DATABASE_URL=
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
OTP_HASH_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
