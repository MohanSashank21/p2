SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=https://your-app.example
