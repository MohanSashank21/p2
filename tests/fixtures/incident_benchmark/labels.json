        {"provider": "tempo", "query": "Fetch the exact trace ID from the incident evidence."},
        {"provider": "loki", "query": "Find structured logs containing that exact trace ID."}
      ],
      "distractor_evidence_ids": [],
      "expected_abstention": false,
      "expected_correlations": [
        {
          "kind": "shared_trace_id",
          "value": "0123456789abcdef0123456789abcdef",
          "left_evidence_id": "trace-checkout",
          "right_evidence_id": "logs-checkout-trace"
        },
        {
          "kind": "shared_service",
          "value": "checkout",
          "left_evidence_id": "trace-checkout",
          "right_evidence_id": "logs-checkout-trace"
        }
      ]
    },
