{
  "benchmark_version": "1.0",
  "scenarios": [
    {
      "scenario_id": "metric-regression",
      "expected_cause": "The checkout process exits after logging an invalid database URL configuration; the target then transitions from up to down.",
      "relevant_evidence_ids": ["metrics-api-up", "logs-api-error"],
      "valid_discriminating_queries": [
        {"provider": "prometheus", "query": "Compare up for checkout across the incident window."},
        {"provider": "loki", "query": "Inspect checkout error logs around the metric transition."}
      ],
      "distractor_evidence_ids": [],
      "expected_abstention": false,
      "expected_correlations": [
        {
          "kind": "shared_service",
          "value": "checkout",
          "left_evidence_id": "metrics-api-up",
          "right_evidence_id": "logs-api-error"
        }
      ]
    },
    {
      "scenario_id": "log-trace-error",
